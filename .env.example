# Poruko self-host environment (alpha)
# Copy to .env and edit before: docker compose up -d
# All-in-one (bundled Postgres + Redis): set COMPOSE_PROFILES=bundle and DB_HOST=db / REDIS_HOST=redis
# Existing Postgres/Redis: leave COMPOSE_PROFILES empty and point DB_* / REDIS_* at your instances

PORUKO_VERSION=latest
PORUKO_HTTP_PORT=8080

# Enable bundled Postgres + Redis services (optional)
COMPOSE_PROFILES=bundle

APP_NAME=Poruko
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_DEFAULT_CURRENCY=EUR

# Comma-separated proxy IPs/CIDRs, or * to trust all (default behind a reverse proxy)
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (required; used by the app and by the optional bundled db service) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poruko
DB_USERNAME=poruko
DB_PASSWORD=change-me

# --- Redis (required when QUEUE/CACHE/SESSION use redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Must exceed queue worker --timeout (210) and the statement-import job timeout (180).
REDIS_QUEUE_RETRY_AFTER=240

# Product flags
LOCK_REGISTRATION_AFTER_FIRST_USER=true
ENFORCE_2FA=false

# Entrypoint: run migrations on api container start
RUN_MIGRATIONS=true
