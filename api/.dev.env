# Docker Compose dev overrides (merged after api/.env). No secrets — safe to commit.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poruko
DB_USERNAME=poruko
DB_PASSWORD=poruko

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Must exceed queue worker --timeout (210) and the statement-import job timeout (180).
REDIS_QUEUE_RETRY_AFTER=240

APP_URL=http://localhost:8000
APP_DEFAULT_CURRENCY=EUR
