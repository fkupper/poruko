# Docker Compose dev overrides (merged after api/.env). No secrets — safe to commit.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=poruko
DB_USERNAME=poruko
DB_PASSWORD=poruko

REDIS_CLIENT=phpredis
